# 로컬 테스트용. 실제 값은 .env 에 넣고 절대 커밋하지 않는다.
# 운영 값은 GitHub Secrets 와 Cloudflare Worker Secrets 에 각각 등록한다.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# 선택 — yfinance 가 막혔을 때 쓰는 예비 시세 소스 (twelvedata.com 무료 800회/일)
TWELVEDATA_API_KEY=

# 권장 — 실시간 "현재가" 표시의 기본 소스 (Alpaca Market Data API)
# 없으면 Yahoo 5분봉의 마지막 값으로 대체되는데, 그건 간헐적으로 며칠씩 묵을 수 있다.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
